###############################################################################
# VPS Unified AI Hub — Environment Configuration
###############################################################################
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env to git — it contains secrets!
###############################################################################

# =============================================================================
# DOMAIN (leave blank to use IP address, set for auto-HTTPS)
# =============================================================================
DOMAIN=

# =============================================================================
# LLM API KEYS — Add the ones you have, leave others blank
# =============================================================================

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
# You already have this one
ANTHROPIC_API_KEY=

# OpenAI (ChatGPT) — https://platform.openai.com/api-keys
# You already have this one
OPENAI_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
# Sign up free, extremely cheap ($0.14/1M tokens). See README for walkthrough.
DEEPSEEK_API_KEY=

# Groq — https://console.groq.com/keys
# Sign up free, 1,000 requests/day free tier. See README for walkthrough.
GROQ_API_KEY=

# Groq (secondary account) — doubles free tier to 2,000 requests/day
# LiteLLM load-balances across both keys automatically.
# Leave blank if you only have one account.
GROQ_API_KEY_2=

# MiniMax — https://www.minimax.io/ (optional)
# Leave blank if you don't have one yet
MINIMAX_API_KEY=

# =============================================================================
# OLLAMA (Remote server on Oracle Cloud — see README Part 2)
# =============================================================================
# Set this to your Oracle Cloud instance IP after setting it up
# Format: http://ORACLE_IP:11434
# Leave blank if not using remote Ollama yet
OLLAMA_BASE_URL=

# =============================================================================
# APPLICATION SECRETS — Generate random values for these
# =============================================================================

# Open WebUI session secret (generate with: openssl rand -hex 32)
WEBUI_SECRET_KEY=

# LiteLLM master key for admin access
# Must start with "sk-". Generate with: echo "sk-$(openssl rand -hex 16)"
# If left blank, deploy.sh auto-generates one.
LITELLM_MASTER_KEY=

# LiteLLM salt key for encrypting stored credentials (generate with: openssl rand -hex 32)
# WARNING: Do not change this after initial setup — it encrypts stored API keys
LITELLM_SALT_KEY=

# =============================================================================
# OPENCLAW CONFIGURATION
# =============================================================================
# Password to access the OpenClaw web UI at /openclaw/
# Set your own password here (any string you want).
# If left blank, deploy.sh auto-generates a random one.
# To change it later: edit this value, then run:
#   docker compose up -d --force-recreate openclaw
OPENCLAW_PASSWORD=

# PostgreSQL password for LiteLLM database
# If left blank, deploy.sh auto-generates one. To set manually: openssl rand -hex 16
DB_PASSWORD=

# OpenClaw reads the same API keys above (ANTHROPIC_API_KEY, OPENAI_API_KEY).
# No additional keys needed here.

# Telegram bot token (optional)
# Get one from @BotFather on Telegram. Enables agents to communicate via Telegram.
TELEGRAM_BOT_TOKEN=

# =============================================================================
# ADVANCED (usually leave defaults)
# =============================================================================
# SSH port used by setup-server.sh (default: 2222)
SSH_PORT=2222

# Docker Compose project name
COMPOSE_PROJECT_NAME=ai-hub
