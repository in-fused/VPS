FROM python:3.12-slim

# Minimal system deps for Scrapling "fast" fetcher only (curl_cffi TLS fingerprinting)
# No Chromium/Playwright — saves ~400MB disk on Oracle ARM
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-light.txt .
RUN pip install --no-cache-dir -r requirements-light.txt

# Skip 'scrapling install' — no browser binaries needed for fast fetcher
# stealth/browser methods won't work, but fast handles most scraping needs

COPY api.py .

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
