# =============================================================================
# Caddyfile — Reverse Proxy for AI Hub
# =============================================================================
# When DOMAIN is set in .env: automatic HTTPS via Let's Encrypt
# When DOMAIN is empty: HTTP on port 80 (access via IP address)
# =============================================================================

{$DOMAIN::80} {

	# =========================================================================
	# Security Headers
	# =========================================================================
	header {
		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"
		# XSS protection
		X-XSS-Protection "1; mode=block"
		# Prevent MIME type sniffing
		X-Content-Type-Options "nosniff"
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove server identification
		-Server
	}

	# =========================================================================
	# LiteLLM API Gateway — /api/litellm/*
	# =========================================================================
	handle_path /api/litellm/* {
		reverse_proxy litellm:4000
	}

	# =========================================================================
	# OpenClaw Web UI + WebSocket Gateway — /openclaw/*
	# =========================================================================
	# Cookie-based auth gate: caddy-entrypoint.sh exports WORKSPACE_PASS_SHA256,
	# unauthenticated requests get a login page, authenticated get proxied.
	# flush_interval -1 disables response buffering (required for WebSocket/SSE).
	# header_down strips upstream frame-blocking headers for iframe embedding.
	@openclawbare path /openclaw
	redir @openclawbare /openclaw/ 301
	handle /openclaw/* {
		@oc_authed cookie mc_oc {$WORKSPACE_PASS_SHA256}

		handle @oc_authed {
			reverse_proxy openclaw:18789 {
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-For {remote_host}
				header_up X-Forwarded-Proto {scheme}
				header_down -X-Frame-Options
				header_down -Content-Security-Policy
				flush_interval -1
			}
		}

		handle {
			rewrite * /openclaw-auth.html
			templates
			root * /srv/workspace
			file_server
		}
	}

	# =========================================================================
	# OpenClaw WebSocket — root path upgrade
	# =========================================================================
	# The Control UI JavaScript connects its WebSocket to wss://host/
	# (root path, ignoring basePath). Route root-path WebSocket upgrades
	# to OpenClaw. Open WebUI's WebSocket uses /socket.io/ so no conflict.
	@openclawws {
		path /
		header Upgrade websocket
	}
	handle @openclawws {
		reverse_proxy openclaw:18789 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
		}
	}

	# =========================================================================
	# Agent Workspace (Mission Control) — /workspace/*
	# =========================================================================
	# Auth is handled client-side: caddy-entrypoint.sh computes a SHA-256
	# hash of WORKSPACE_PASSWORD, Caddy templates injects it into index.html,
	# and the login screen verifies user input against it.
	# Bare /workspace redirects to /workspace/ for direct URL access.
	@workspacebare path /workspace
	redir @workspacebare /workspace/ 301
	handle_path /workspace/* {
		templates
		header Cache-Control "no-cache"
		root * /srv/workspace
		file_server
	}

	# =========================================================================
	# Open WebUI — Everything else (main frontend + landing page)
	# =========================================================================
	# Open WebUI requires the root path (/) — its SvelteKit SPA has no
	# /chat route; the chat interface IS the root page. All paths not
	# matched above fall through here: /, /auth, /c/*, /_app/*, etc.
	handle {
		reverse_proxy open-webui:8080
	}

	# =========================================================================
	# Logging
	# =========================================================================
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
