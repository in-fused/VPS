###############################################################################
# Oracle ARM — Environment Configuration
###############################################################################
# These are the API keys and secrets for LiteLLM + supporting services.
# Copy from your EC2 .env — the keys must match.
#
# IMPORTANT: LITELLM_MASTER_KEY must be identical to EC2's .env
# (Caddy and OpenClaw on EC2 use it to authenticate with LiteLLM here)
###############################################################################

# === Must match EC2 .env ===
LITELLM_MASTER_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
MINIMAX_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
MISTRAL_API_KEY=

# === Oracle-local secrets (auto-generated by deploy-oracle.sh) ===
DB_PASSWORD=
LITELLM_SALT_KEY=
